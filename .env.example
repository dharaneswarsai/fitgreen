# =============================================
# FITGREEN Growth System — environment
#
# The app runs with ZERO configuration using the local
# demo datastore (browser localStorage). Everything below
# is optional and only needed to switch to live Postgres.
#
# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it is gitignored.
# =============================================

# --- Supabase (optional) --------------------------------
# Supabase-first with a localStorage fallback. When the two
# keys below are present the app reads and writes to live
# Postgres (schema `gym`) instead of the local demo store.
# Get them from: Dashboard -> Project -> Settings -> API
#
# Before it works you must also run supabase/schema.sql
# once in the Supabase SQL Editor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI insights (optional) -----------------------------
# The insights panel is fully deterministic and works with
# no configuration. Setting a key is reserved for a future
# provider integration; nothing is called while it is empty.
VITE_AI_API_KEY=
VITE_AI_MODEL=
